{
  "name": "drift",
  "version": "0.1.0",
  "private": true,
  "description": "Security copilot for manual web security testing in Caido (MCP + local CLI)",
  "license": "MIT",
  "author": "six2dez <six2dez@gmail.com> (https://github.com/six2dez)",
  "repository": {
    "type": "git",
    "url": "https://github.com/six2dez/drift.git"
  },
  "bugs": {
    "url": "https://github.com/six2dez/drift/issues"
  },
  "homepage": "https://github.com/six2dez/drift#readme",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ./packages/**/src --fix",
    "format": "prettier --write \"packages/**/src/**/*.{vue,ts,js,json}\"",
    "build": "caido-dev build && cp -r packages/backend/assets/* dist/plugin_package/backend/assets/ 2>/dev/null; rm -f dist/plugin_package.zip dist/drift.zip && cd dist/plugin_package && zip -r ../drift.zip . -x '*.DS_Store'",
    "watch": "caido-dev watch"
  },
  "devDependencies": {
    "@caido-community/dev": "0.1.6",
    "@caido/tailwindcss": "0.1.0",
    "@vitejs/plugin-vue": "6.0.1",
    "postcss": "8.5.6",
    "postcss-prefixwrap": "1.57.2",
    "prettier": "3.8.1",
    "tailwindcss": "3.4.13",
    "tailwindcss-primeui": "0.3.4",
    "typescript": "5.5.4",
    "vite": "6.0.7",
    "vitest": "4.0.18"
  },
  "workspaces": [
    "packages/*"
  ]
}
